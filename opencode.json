{
  "$schema": "https://opencode.ai/config.json",

  "permission": {
    "read": {
      "*": "allow",

      "*.env": "deny",
      "*.env.*": "deny",

      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",

      "**/.ssh/**": "deny",
      "**/secrets/**": "deny",

      ".env.example": "allow",
      ".env.sample": "allow"
    },

    "edit": {
      "*": "allow",

      "*.env": "deny",
      "*.env.*": "deny",

      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",

      "**/.ssh/**": "deny",
      "**/secrets/**": "deny",

      ".env.example": "allow",
      ".env.sample": "allow"
    },

    "bash": {
      "*": "ask",

      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git branch *": "allow",

      "jj status *": "allow",
      "jj st *": "allow",
      "jj diff *": "allow",
      "jj log *": "allow",

      "jj commit *": "ask",
      "jj describe *": "ask",
      "jj desc *": "ask",
      "jj squash *": "ask",
      "jj new *": "ask",
      "jj abandon *": "ask",
      "jj push *": "deny",

      "uv *": "allow",
      "python *": "allow",

      "ruff *": "allow",
      "mypy *": "allow",

      "pytest *": "allow",
      "pre-commit *": "allow",
      "make check *": "allow",

      "grep *": "allow",
      "rg *": "allow",
      "find *": "allow",
      "ls *": "allow",
      "head *": "allow",
      "echo *": "allow",

      "git commit *": "ask",

      "git push *": "deny",

      "sudo *": "deny",
      "rm -rf *": "deny"
    },

    "external_directory": "ask",

    "webfetch": "allow",
    "websearch": "allow",

    "task": "allow"
  }
}
