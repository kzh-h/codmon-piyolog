CODMON_EMAIL=<email>
CODMON_PASSWORD=<password>

PIYOLOG_FEED_URL=<piyolog feed url>

GAS_URL=<gas url>
GAS_KEY=<gas key>

# Optional: GCS bucket for uploading run artifacts (trace, screenshots, logs)
# to gs://<bucket>/runs/<run_id>/ . Locally, nothing is uploaded if unset.
GCS_TRACE_BUCKET=<gcs bucket name>

# Optional: base directory for run artifacts (<base>/runs/<run_id>/)
# default: <repo>/tmp locally, /tmp on GCP
# ARTIFACTS_DIR=./tmp
